# Secrets are loaded by the core only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
SONIOX_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
JARVIS_WAKE_WORD_PYTHON=
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
JARVIS_CONFIG_PATH=
JARVIS_DATA_DIR=
JARVIS_LOG_LEVEL=info

# Required when Core and Dashboard are started as separate services.
VITE_JARVIS_CORE_URL=http://127.0.0.1:43117
JARVIS_SESSION_TOKEN=replace-with-the-same-long-random-secret
VITE_JARVIS_SESSION_TOKEN=replace-with-the-same-long-random-secret
