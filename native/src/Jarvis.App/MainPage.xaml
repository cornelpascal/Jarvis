<Page
    x:Class="Jarvis.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jarvis.App.Controls"
    xmlns:models="using:Jarvis.App.ViewModels"
    Background="{StaticResource JarvisBackgroundBrush}">
    <Grid RowSpacing="10" Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" BorderBrush="{StaticResource JarvisCyanBrush}" BorderThickness="1">
                    <TextBlock Text="J" FontFamily="Consolas" Foreground="{StaticResource JarvisCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="J.A.R.V.I.S." Foreground="{StaticResource JarvisCyanBrush}" FontSize="14" CharacterSpacing="220" />
                    <TextBlock Text="CODEX NATIVE COMMAND SYSTEM" Foreground="{StaticResource JarvisMutedBrush}" FontSize="9" CharacterSpacing="120" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="10" />
                <TextBlock Text="{Binding Clock}" Foreground="{StaticResource JarvisMutedBrush}" FontFamily="Consolas" FontSize="10" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <Border Style="{StaticResource PanelBorderStyle}" Height="280">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource JarvisLineBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="PROJECT MATRIX" Foreground="{StaticResource JarvisCyanBrush}" FontSize="11" CharacterSpacing="120" VerticalAlignment="Center" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding Projects}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectItemViewModel">
                                    <StackPanel Padding="6">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" Foreground="{StaticResource JarvisMutedBrush}" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource JarvisLineBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="CODEX OPERATIONS" Foreground="{StaticResource JarvisCyanBrush}" FontSize="11" CharacterSpacing="120" VerticalAlignment="Center" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding Tasks}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskItemViewModel">
                                    <StackPanel Padding="6">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind State}" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="9" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="300"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <controls:JarvisOrbControl State="{Binding State}" AudioLevel="{Binding AudioLevel}" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="OrbTapped" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                        <TextBlock Text="CORE RESPONSE STATE" Foreground="{StaticResource JarvisMutedBrush}" FontSize="8" CharacterSpacing="160" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding State}" Foreground="{StaticResource JarvisCyanBrush}" FontSize="11" CharacterSpacing="220" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="52"/><RowDefinition Height="74"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="12,0" BorderBrush="{StaticResource JarvisLineBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="COMMAND CHANNEL" Foreground="{StaticResource JarvisCyanBrush}" FontSize="11" CharacterSpacing="120" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="STOP" Click="StopClicked" />
                                <Button Content="VOICE" Click="VoiceClicked" />
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="MessageList" Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MessageItemViewModel">
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="9" CharacterSpacing="100" />
                                        <controls:MarkdownPresenter Markdown="{x:Bind Content, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="2" Padding="12,6" BorderBrush="{StaticResource JarvisLineBrush}" BorderThickness="0,1,0,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="LIVE TRANSCRIPT" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="9" CharacterSpacing="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding LiveTranscript}" Foreground="{StaticResource JarvisBrightBrush}" FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" AutomationProperties.Name="Live voice transcript" />
                        </Grid>
                        <Grid Grid.Row="3" Padding="10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PromptBox" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter directive for Codex…" AcceptsReturn="True" KeyDown="PromptKeyDown" />
                            <Button Grid.Column="1" Content="EXECUTE" Click="ExecuteClicked" MinWidth="92" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <TabView IsAddTabButtonVisible="False">
                    <TabViewItem Header="CODEX">
                        <ListView ItemsSource="{Binding Activities}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ActivityItemViewModel">
                                    <StackPanel Padding="8" Spacing="3">
                                        <TextBlock Text="{x:Bind Label}" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="10" />
                                        <TextBlock Text="{x:Bind Detail}" Foreground="{StaticResource JarvisMutedBrush}" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TabViewItem>
                    <TabViewItem Header="SHELL">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding TerminalText}" Foreground="{StaticResource JarvisBrightBrush}" FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                            <Grid Grid.Row="1" Padding="6" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ShellCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PowerShell command" KeyDown="ShellKeyDown" />
                                <Button Grid.Column="1" Content="RUN" Click="RunShellClicked" />
                            </Grid>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="DIFF">
                        <ScrollViewer><TextBlock Text="{Binding Diff}" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="NoWrap" IsTextSelectionEnabled="True" /></ScrollViewer>
                    </TabViewItem>
                </TabView>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource JarvisMutedBrush}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="18" VerticalAlignment="Center">
                <TextBlock Text="YOLO · DANGER FULL ACCESS" Foreground="{StaticResource JarvisDangerBrush}" FontFamily="Consolas" FontSize="9" />
                <TextBlock Text="VOICE VAD · 1000 MS" Foreground="{StaticResource JarvisCyanBrush}" FontFamily="Consolas" FontSize="9" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
